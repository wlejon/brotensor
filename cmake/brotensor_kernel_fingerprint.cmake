# brotensor's kernel source fingerprint: first 64 bits of a SHA-256 over all
# kernel builder and emitter sources in src/kernels/, src/jit/gpu_mir* / *_emit*,
# and src/cuda/cu_mir_*. Used by KernelDiskCache so edits to kernel builders
# invalidate cached PTX/SPIR-V/MSL/CPU blobs automatically without manual version
# bumps.
#
# Run in script mode:
#   cmake -DBROTENSOR_ROOT=<repo> -DOUT=<file.cpp> -P <this>
# Rewrites OUT only when the fingerprint changes.

if(NOT BROTENSOR_ROOT OR NOT OUT)
    message(FATAL_ERROR "brotensor_kernel_fingerprint.cmake: set BROTENSOR_ROOT and OUT")
endif()

file(GLOB_RECURSE _files RELATIVE "${BROTENSOR_ROOT}"
    "${BROTENSOR_ROOT}/src/kernels/*"
    "${BROTENSOR_ROOT}/src/jit/gpu_mir*"
    "${BROTENSOR_ROOT}/src/jit/ptx_emit*"
    "${BROTENSOR_ROOT}/src/jit/spirv_emit*"
    "${BROTENSOR_ROOT}/src/jit/msl_emit*"
    "${BROTENSOR_ROOT}/src/cuda/cu_mir_builders.*"
    "${BROTENSOR_ROOT}/src/cuda/cu_mir_cache.*")
list(SORT _files)
set(_material "")
foreach(_f IN LISTS _files)
    file(SHA256 "${BROTENSOR_ROOT}/${_f}" _h)
    string(APPEND _material "${_f}\n${_h}\n")
endforeach()
string(SHA256 _sha "${_material}")
string(SUBSTRING "${_sha}" 0 16 _fingerprint)

set(_text "// Generated by cmake/brotensor_kernel_fingerprint.cmake; do not edit.
#include <string_view>

namespace brotensor::jit {

std::string_view kernel_source_fingerprint() noexcept { return \"${_fingerprint}\"; }

} // namespace brotensor::jit
")
set(_old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _text)
    file(WRITE "${OUT}" "${_text}")
endif()
