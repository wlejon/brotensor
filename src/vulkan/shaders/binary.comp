#version 460
// In-place binary: y[i] = f(y[i], x[i]) over n elements. y has dtype DTY and
// x dtype DTX (-DDTY / -DDTX); the only mixed pair built is FP32 y += FP16 x,
// the one add_inplace accepts. OP (spec constant 0) from op_codes.h.
#include "common.glsl"
#include "op_codes.h"

layout(local_size_x = 256) in;
layout(constant_id = 0) const uint OP = 0;
layout(push_constant) uniform PC {
    uint64_t y;
    uint64_t x;
    uint n;
    float a;
    float b;
} pc;

void main() {
    const uint stride = GRID_STRIDE_X;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += stride) {
        const float yv = load_elem(DTY, pc.y, i);
        const float xv = load_elem(DTX, pc.x, i);
        // `precise`: no FMA contraction, so a*y + b*x rounds like the FP32
        // expression it is on the CPU / CUDA / HIP backends.
        precise float r;
        switch (OP) {
            case BOP_ADD:   r = yv + xv; break;
            case BOP_MUL:   r = yv * xv; break;
            case BOP_DIV:   r = yv / xv; break;
            case BOP_AXPBY: r = pc.a * yv + pc.b * xv; break;
            default:        r = yv; break;
        }
        store_elem(DTY, pc.y, i, r);
    }
}
