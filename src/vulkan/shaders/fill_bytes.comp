#version 460
// Byte-granular fill, for the unaligned edges of a memset that
// vkCmdFillBuffer (4-byte offsets and sizes) cannot cover.
#include "common.glsl"

layout(local_size_x = 64) in;
layout(push_constant) uniform PC {
    uint64_t dst;
    uint n;
    uint value;
} pc;

void main() {
    const uint stride = GRID_STRIDE_X;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += stride) {
        U8Buf(pc.dst).v[i] = uint8_t(pc.value & 0xffu);
    }
}
