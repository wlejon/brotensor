#version 460
// Per-row weight-only quantisation (ops_quant.cpp: quantize_rows,
// dequantize_rows), INT8 or FP8 E4M3 codes with one FP32 scale per row.
// -DDT: the dtype of the unquantised W (0 = FP32, 1 = FP16, 2 = BF16).
//
// MODE 0, quantize: one workgroup per row (2D grid) reduces max|W[r, :]|,
// writes scale = max / qmax (qmax 127 or 448) and the codes W / scale, INT8
// rounded half to even and clamped to +-127, FP8 through fp8_encode. The
// CPU's codes and scales come out byte for byte: both divisions are
// correctly rounded (div_cr), as the host's are, without relying on fma.
// MODE 1, dequantize: W = decode(code) * scale[row], one FP32 multiply,
// rounded once to DT; grid-stride over the elements.
#include "common.glsl"
#include "fp8.glsl"
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 256) in;
layout(constant_id = 0) const uint MODE = 0;
layout(constant_id = 1) const uint FP8 = 0;

layout(push_constant) uniform PC {
    uint64_t w;       // (rows, k) DT
    uint64_t q;       // (rows, k) codes
    uint64_t scale;   // (rows) FP32
    uint rows, k;
} pc;

shared float s_max[32];

// a - q b exactly (Dekker's product: q b = p + e with Veltkamp halves, every
// step `precise` so nothing is contracted into an fma, which Vulkan does not
// promise to fuse). Exact while q is within a few ulp of a / b: the
// remainder is then representable.
float rem_exact(float a, float q, float b) {
    precise const float p = q * b;
    precise const float tq = 4097.0 * q, tb = 4097.0 * b;
    precise const float qh = tq - (tq - q), bh = tb - (tb - b);
    precise const float ql = q - qh, bl = b - bh;
    precise const float e = ((qh * bh - p) + qh * bl + ql * bh) + ql * bl;
    precise const float r = (a - p) - e;
    return r;
}

// a / b correctly rounded (operands, quotient and remainders normal or zero,
// b > 0), as the host's division: an estimate refined by its exact
// remainder, then whichever of it and its two neighbours leaves the smallest
// remainder (a quotient of two floats is never a tie).
float div_cr(float a, float b) {
    if (a == 0.0) return a;   // keeps the sign of zero
    precise const float r = 1.0 / b;
    precise const float q0 = a * r;
    precise const float q = q0 + rem_exact(a, q0, b) * r;
    const float dn = uintBitsToFloat(floatBitsToUint(q) - 1u);
    const float up = uintBitsToFloat(floatBitsToUint(q) + 1u);
    const float e = abs(rem_exact(a, q, b)), ed = abs(rem_exact(a, dn, b)), eu = abs(rem_exact(a, up, b));
    float best = q;
    if (ed < e) best = dn;
    if (eu < min(e, ed)) best = up;
    return best;
}

uint encode(float v) {
    if (FP8 != 0u) return fp8_encode(v);
    return uint(int(clamp(roundEven(v), -127.0, 127.0))) & 0xffu;
}

void quantize() {
    const uint row = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (row >= pc.rows) return;
    const uint tid = gl_LocalInvocationID.x;
    const uint base = row * pc.k;
    float mx = 0.0;
    for (uint c = tid; c < pc.k; c += 256u) mx = max(mx, abs(load_elem(DT, pc.w, base + c)));
    mx = subgroupMax(mx);
    if (subgroupElect()) s_max[gl_SubgroupID] = mx;
    barrier();
    mx = 0.0;
    for (uint i = 0; i < gl_NumSubgroups; ++i) mx = max(mx, s_max[i]);
    const float scale = div_cr(mx, FP8 != 0u ? 448.0 : 127.0);
    if (tid == 0u) F32Buf(pc.scale).v[row] = scale;
    for (uint c = tid; c < pc.k; c += 256u) {
        const float v = scale > 0.0 ? div_cr(load_elem(DT, pc.w, base + c), scale) : 0.0;
        U8Buf(pc.q).v[base + c] = uint8_t(encode(v));
    }
}

void dequantize() {
    const uint n = pc.rows * pc.k;
    for (uint i = gl_GlobalInvocationID.x; i < n; i += GRID_STRIDE_X) {
        const uint b = uint(U8Buf(pc.q).v[i]);
        const float code = FP8 != 0u ? fp8_decode(b) : float(int(b << 24) >> 24);
        store_elem(DT, pc.w, i, code * F32Buf(pc.scale).v[i / pc.k]);
    }
}

void main() {
    if (MODE == 0u) quantize();
    else dequantize();
}
