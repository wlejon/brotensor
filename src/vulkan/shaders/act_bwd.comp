#version 460
// Activation backward: dX[i] = g(p[i], dY[i]) over n elements of dtype DT.
// p is the forward input x or output y, as each op's contract says
// (op_codes.h). dX may alias dY: every element reads both inputs before it
// writes. Overwrites dX (activations have no parameters to accumulate).
#include "common.glsl"
#include "op_codes.h"

layout(local_size_x = 256) in;
layout(constant_id = 0) const uint OP = 0;
layout(push_constant) uniform PC {
    uint64_t p;
    uint64_t dy;
    uint64_t dx;
    uint n;
    float a;
} pc;

float grad(float v, float g) {
    switch (OP) {
        case GOP_RELU:       return v > 0.0 ? g : 0.0;
        case GOP_TANH: {
            const float vc = clamp(v, -1.0, 1.0);
            return g * (1.0 - vc * vc);
        }
        case GOP_SIGMOID: {
            const float vc = clamp(v, 0.0, 1.0);
            return g * (vc * (1.0 - vc));
        }
        case GOP_SILU: {
            const float vc = clamp(v, -88.0, 88.0);
            const float s = bt_sigmoid(vc);
            return g * (s * (1.0 + vc * (1.0 - s)));
        }
        case GOP_GELU_TANH:  return g * bt_gelu_tanh_grad(v);
        case GOP_GELU_EXACT: {
            const float vc = clamp(v, -20.0, 20.0);
            return g * (0.5 * (1.0 + bt_erf(vc * 0.7071067811865475)) +
                        vc * 0.3989422804014327 * exp(-0.5 * vc * vc));
        }
        case GOP_QUICK_GELU: {
            const float vc = clamp(v, -50.0, 50.0);
            const float s = bt_sigmoid(1.702 * vc);
            return g * (s + 1.702 * vc * s * (1.0 - s));
        }
        case GOP_EXP:        return g * exp(clamp(v, -88.0, 88.0));
        case GOP_LOG:        return g / max(v, 1e-37);
        case GOP_SIN:        return g * cos(v);
        case GOP_COS:        return -g * sin(v);
        case GOP_RSQRT:      return -0.5 * g * v * v * v;
        case GOP_ELU:        return g * (v > 0.0 ? 1.0 : pc.a * exp(clamp(v, -88.0, 0.0)));
        case GOP_LEAKY_RELU: return g * (v > 0.0 ? 1.0 : pc.a);
        case GOP_PASS:       return g;
    }
    return g;
}

void main() {
    const uint stride = GRID_STRIDE_X;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += stride) {
        const float g = load_elem(DT, pc.dy, i);
        const float v = (OP == GOP_PASS) ? 0.0 : load_elem(DT, pc.p, i);
        store_elem(DT, pc.dx, i, grad(v, g));
    }
}
